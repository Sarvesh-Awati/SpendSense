# Frontend build-time configuration.
#
# Only VITE_-prefixed variables reach the browser, and every one of them is
# inlined into the shipped bundle. Never put a secret here.

# Origin of the SpendSense API, WITHOUT a trailing /api.
#
# Leave this unset for local development: requests fall back to the relative
# path /api, which the Vite dev server proxies to http://localhost:5001.
#
# Required in production, where the SPA and the API are on different hosts.
# VITE_API_URL="https://spendsense-api.onrender.com"
