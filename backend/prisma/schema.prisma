datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Currency {
  USD
  EUR
  GBP
  INR
  CAD
  AUD
  JPY
  CNY
  SGD
  AED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  BUDGET_EXCEEDED
  SUBSCRIPTION_RENEWAL
  SAVINGS_REMINDER
  SYSTEM
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  firstName         String?
  lastName          String?
  profilePictureUrl String?
  preferredCurrency Currency       @default(INR)
  // Canonical accounting/reporting currency for the account. Every
  // Transaction.convertedAmount is denominated in this. Deliberately NOT an
  // ordinary editable setting: changing it would invalidate historical
  // conversions, so re-basing must be an explicit, audited operation.
  // Nullable only so existing rows could be backfilled; treat as required.
  baseCurrency      Currency?
  language          String         @default("en")
  dateFormat        String         @default("DD/MM/YYYY")
  timeFormat        String         @default("12h")
  theme             String         @default("dark")
  budgetAlerts      Boolean        @default(true)
  savingsReminders  Boolean        @default(true)
  subscriptionRenewals Boolean     @default(true)
  receiptScanNotifications Boolean @default(true)
  emailNotifications Boolean       @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  // Relations
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  goals              Goal[]
  subscriptions      Subscription[]
  notifications      Notification[]
  receipts           Receipt[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  // Only the SHA-256 hash of the refresh token is stored. The raw token is
  // returned to the client once, at issue time, and never persisted — so a
  // database disclosure cannot be replayed as a valid session.
  tokenHash String   @unique
  expiresAt DateTime
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  type      CategoryType
  icon      String?
  color     String?
  userId    String?      @db.Uuid // Nullable for system-wide categories
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  subscriptions Subscription[]

  @@unique([name, userId])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id             String       @id @default(uuid()) @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  currency       Currency     @default(INR)
  baseCurrency   Currency?
  exchangeRate   Decimal?     @db.Decimal(10, 6)
  convertedAmount Decimal?    @db.Decimal(12, 2)
  description    String?
  merchant       String?
  date           DateTime
  type           CategoryType
  paymentMethod  String?
  isSubscription Boolean      @default(false)
  userId         String       @db.Uuid
  categoryId     String       @db.Uuid
  receiptId      String?      @unique @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  receipt  Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, isSubscription])
  @@map("transactions")
}

model Budget {
  id         String    @id @default(uuid()) @db.Uuid
  amount     Decimal   @db.Decimal(12, 2)
  currency   Currency  @default(INR)
  baseCurrency Currency?
  exchangeRate Decimal?  @db.Decimal(10, 6)
  convertedAmount Decimal? @db.Decimal(12, 2)
  startDate  DateTime
  endDate    DateTime
  userId     String    @db.Uuid
  categoryId String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, categoryId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0.00) @db.Decimal(12, 2)
  currency      Currency  @default(INR)
  baseCurrency  Currency?
  exchangeRate  Decimal?  @db.Decimal(10, 6)
  convertedAmount Decimal? @db.Decimal(12, 2)
  targetDate    DateTime?
  userId        String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model Subscription {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  amount      Decimal               @db.Decimal(12, 2)
  currency    Currency              @default(INR)
  baseCurrency Currency?
  exchangeRate Decimal?             @db.Decimal(10, 6)
  convertedAmount Decimal?          @db.Decimal(12, 2)
  frequency   SubscriptionFrequency
  startDate   DateTime
  nextRenewal DateTime?
  isActive    Boolean               @default(true)
  userId      String                @db.Uuid
  categoryId  String?               @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, nextRenewal])
  @@map("subscriptions")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  title     String
  message   String
  isRead    Boolean          @default(false)
  type      NotificationType
  userId    String           @db.Uuid
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Receipt {
  id                String       @id @default(uuid()) @db.Uuid
  imageUrl          String
  rawText           String?      @db.Text
  extractedMerchant String?
  extractedAmount   Decimal?     @db.Decimal(12, 2)
  extractedDate     DateTime?
  userId            String       @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([userId])
  @@map("receipts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String    @db.Uuid
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
