# Dependency directories
node_modules/
jspm_packages/
web_stage/

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# ...but the templates MUST be committed. `.env.*` above matched
# `.env.example`, so the files documenting required configuration were
# silently absent from the repository and a fresh clone had nothing to copy.
!.env.example
!**/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# IDE and Agent artifacts we want to keep git clean from
.gemini/
.agents/
.next/
backend/.env
