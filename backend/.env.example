# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (Local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/spendsense"

# Access-token signing secret.
# In production this must be at least 32 characters — the server refuses to
# boot otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# There is no refresh-token secret: refresh tokens are opaque random values
# looked up by SHA-256 hash, not signed JWTs, so nothing would sign or verify
# them. To invalidate every session, clear the `refresh_tokens` table.
JWT_SECRET="your_jwt_access_secret_here"

# Browser origins allowed to call this API, comma-separated. There is NO
# wildcard: an origin that is not listed is refused.
# Development defaults to the Vite dev server when unset; production requires
# an explicit value.
# CORS_ORIGINS="https://spendsense.vercel.app"

# Exchange rates (multi-currency reporting)
# Without a key, transactions in a currency other than the account base
# currency are rejected with 503 rather than stored with a wrong conversion.
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_BASE_URL="https://api.exchangerate.host"

# AI Integration APIs
GEMINI_API_KEY="your_gemini_api_key_here"

# Public base URL of the frontend. Used to build password reset links.
# Set this per environment — do not leave it at localhost in production.
APP_URL="http://localhost:3000"

# Email Provider Configuration (Transactional Email via SMTP / Resend / SendGrid / Mailtrap)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM="SpendSense <no-reply@spendsense.app>"
